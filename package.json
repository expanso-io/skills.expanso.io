  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "npm@12.0.2",
  "scripts": {
    "build": "esbuild src/consent-runtime.js --bundle --format=iife --platform=browser --target=es2017 --minify --legal-comments=none --outfile=docs/js/consent-runtime.js",
