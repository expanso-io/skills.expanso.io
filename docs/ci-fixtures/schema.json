{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "email", "tier", "balance", "created_at", "active"],
  "properties": {
    "id": {"type": "string", "pattern": "^cust-[0-9]{5}$"},
    "name": {"type": "string", "minLength": 3},
    "email": {"type": "string", "pattern": "^tester[0-9]+@example\\.invalid$"},
    "tier": {"enum": ["gold", "silver", "bronze"]},
    "balance": {"type": "string", "pattern": "^[0-9]+\\.[0-9]{2}$"},
    "created_at": {"type": "string", "pattern": "^20[0-9]{2}-[0-9]{2}-[0-9]{2}T00:00:00Z$"},
    "active": {"type": "boolean"}
  }
}
